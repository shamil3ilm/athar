{
    "name": "athar/shim-laravel",
    "description": "athar in-process shim for Laravel / PSR-15. Captures, redacts, and hands off to the local athar daemon.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-sockets": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "laravel/framework": "^10.0 || ^11.0"
    },
    "suggest": {
        "laravel/framework": "For automatic instrumentation via the Laravel service provider."
    },
    "autoload": {
        "psr-4": {
            "Athar\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Athar\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Athar\\Adapter\\Laravel\\ServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
